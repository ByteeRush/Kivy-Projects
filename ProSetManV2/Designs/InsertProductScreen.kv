<InsertProductScreen>:
    name: "insertproduct"
    Image:
        source: "images/insert_image.png"
        size: root.size
        pos: self.pos
        allow_stretch: True   
        keep_ratio: False     
        mipmap: True

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        size: root.size

        BoxLayout:
            size_hint_y: None
            height: self.minimum_height
            orientation: "vertical"
            padding: dp(20)
            spacing: dp(15)

            # 1. Üst Başlık Alanı
            BoxLayout:
                size_hint_y: None
                height:self.minimum_height

                Label:
                    id: ins_label
                    text: "ProSetMan - Ürün Ekleme"
                    font_size: '28sp'
                    font_name: "materials/Pacifico-Regular.ttf"
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size
                    color: (0.0, 0.95, 0.5, 1)
                    size_hint_y: None
                    height: self.texture_size[1]  # Yazının o anki gerçek yüksekliği
                    text_size: self.width, None    # Genişlik sabit, yükseklik serbest (alt alta kayabilir)
                    halign: 'left'
                    valign: 'middle'

            # 2. AnchorLayout ile Ortala
            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                size_hint_y: None
                height: insert_card.height

                # Esnek ve Dinamik Kart / Panel (Transparan Yeşil Cyberpunk Konsept)
                BoxLayout:
                    id: insert_card
                    orientation: "vertical"
                    size_hint_x: 0.94      
                    size_hint_y: None
                    height: self.minimum_height   
                    spacing: dp(14)                   
                    padding: [dp(25), dp(20), dp(25), dp(20)]     
                    
                    canvas.before:
                        # Ana Panel Cyber Yeşil Çerçeve (Border)
                        Color:
                            rgba: 0.0, 0.85, 0.4, 0.95   
                        RoundedRectangle:
                            pos: self.x - dp(2), self.y - dp(2) 
                            size: self.width + dp(4), self.height + dp(4) 
                            radius: [dp(26)]                

                        # Register Ekranı Gibi Şeffaf / Transparan Derin Zemin
                        Color:
                            rgba: 0.08, 0.10, 0.08, 0.92 
                        RoundedRectangle:
                            pos: self.pos               
                            size: self.size             
                            radius: [dp(24)]

                    # Firma İsmi
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(45)
                        spacing: dp(15)

                        Label:
                            text: "Firma İsmi"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        Spinner:
                            id: company_spinner
                            text: "Firma Seçiniz..."
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(41)
                            background_normal: ""
                            background_down: ""
                            background_color: 0, 0, 0, 0
                            color: 1, 1, 1, 1
                            font_size: '15sp'
                            halign: "center"
                            valign: "middle"
                            on_press: root.load_companies_to_spinner()
                            on_text: root.on_company_select(self.text)  

                            canvas.before:
                                Color:
                                    rgba: 0.0, 0.85, 0.4, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.14, 0.12, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                    # Ürün Tipi
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(45)
                        spacing: dp(15)

                        Label:
                            text: "Ürün Tipi"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        BoxLayout:
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(45)
                            padding: [dp(4), dp(2)]
                            canvas.before:
                                Color:
                                    rgba: 0.0, 0.85, 0.4, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.14, 0.12, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                            TextInput:
                                id: product_type
                                hint_text: "Giriş Yapınız..."
                                multiline: False
                                foreground_color: (1, 1, 1, 1)
                                cursor_color: (0.0, 0.95, 0.5, 1)
                                hint_text_color: (0.5, 0.5, 0.5, 1)
                                background_normal: ""
                                background_active: ""
                                background_color: 0, 0, 0, 0
                                size_hint_x: 1.0  
                                size_hint_y: None
                                height: dp(41) 
                                font_size: '15sp'
                                padding: [dp(8), (self.height - self.line_height) / 2, dp(8), 0]
                    
                    # Ürün İsmi
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(45)
                        spacing: dp(15)

                        Label:
                            text: "Ürün İsmi"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        BoxLayout:
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(45)
                            padding: [dp(4), dp(2)]
                            canvas.before:
                                Color:
                                    rgba: 0.0, 0.85, 0.4, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.14, 0.12, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                            TextInput:
                                id: product_name
                                hint_text: "Giriş Yapınız..."
                                multiline: False
                                foreground_color: (1, 1, 1, 1)
                                cursor_color: (0.0, 0.95, 0.5, 1)
                                hint_text_color: (0.5, 0.5, 0.5, 1)
                                background_normal: ""
                                background_active: ""
                                background_color: 0, 0, 0, 0
                                size_hint_x: 1.0  
                                size_hint_y: None
                                height: dp(41) 
                                font_size: '15sp'
                                padding: [dp(8), (self.height - self.line_height) / 2, dp(8), 0]

                    # Ürün Adedi
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(45)
                        spacing: dp(15)

                        Label:
                            text: "Ürün Adedi"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        BoxLayout:
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(45)
                            padding: [dp(4), dp(2)]
                            canvas.before:
                                Color:
                                    rgba: 0.0, 0.85, 0.4, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.14, 0.12, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                            TextInput:
                                id: product_count
                                hint_text: "Giriş Yapınız..."
                                multiline: False
                                input_filter: 'int'
                                foreground_color: (1, 1, 1, 1)
                                cursor_color: (0.0, 0.95, 0.5, 1)
                                hint_text_color: (0.5, 0.5, 0.5, 1)
                                background_normal: ""
                                background_active: ""
                                background_color: 0, 0, 0, 0
                                size_hint_x: 1.0  
                                size_hint_y: None
                                height: dp(41) 
                                font_size: '15sp'
                                padding: [dp(8), (self.height - self.line_height) / 2, dp(8), 0]

                    # Ürün Birim Fiyatı
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(45)
                        spacing: dp(15)

                        Label:
                            text: "Ürün Birim Fiyatı"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        BoxLayout:
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(45)
                            padding: [dp(4), dp(2)]
                            canvas.before:
                                Color:
                                    rgba: 0.0, 0.85, 0.4, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.14, 0.12, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                            TextInput:
                                id: product_price
                                hint_text: "Giriş Yapınız..."
                                multiline: False
                                input_filter: 'float'
                                foreground_color: (1, 1, 1, 1)
                                cursor_color: (0.0, 0.95, 0.5, 1)
                                hint_text_color: (0.5, 0.5, 0.5, 1)
                                background_normal: ""
                                background_active: ""
                                background_color: 0, 0, 0, 0
                                size_hint_x: 1.0  
                                size_hint_y: None
                                height: dp(41) 
                                font_size: '15sp'
                                padding: [dp(8), (self.height - self.line_height) / 2, dp(8), 0]

                    # Ürün Toplam Tutar
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(45)
                        spacing: dp(15)

                        Label:
                            text: "Ürün Toplam Tutar"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        BoxLayout:
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(45)
                            padding: [dp(4), dp(2)]
                            canvas.before:
                                Color:
                                    rgba: 0.0, 0.85, 0.4, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.14, 0.12, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                            TextInput:
                                id: product_total_price
                                hint_text: "Giriş Yapınız..."
                                multiline: False
                                foreground_color: (1, 1, 1, 1)
                                cursor_color: (0.0, 0.95, 0.5, 1)
                                hint_text_color: (0.5, 0.5, 0.5, 1)
                                background_normal: ""
                                background_active: ""
                                background_color: 0, 0, 0, 0
                                size_hint_x: 1.0  
                                size_hint_y: None
                                height: dp(41) 
                                font_size: '15sp'
                                padding: [dp(8), (self.height - self.line_height) / 2, dp(8), 0]
                                on_text: root.calculate_total()

                    # Barcode Code
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(45)
                        spacing: dp(15)

                        Label:
                            text: "Barcode Code"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        BoxLayout:
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(45)
                            padding: [dp(4), dp(2)]
                            canvas.before:
                                Color:
                                    rgba: 0.0, 0.85, 0.4, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.14, 0.12, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                            TextInput:
                                id: product_barcode
                                hint_text: "Giriş Yapınız..."
                                multiline: False
                                foreground_color: (1, 1, 1, 1)
                                cursor_color: (0.0, 0.95, 0.5, 1)
                                hint_text_color: (0.5, 0.5, 0.5, 1)
                                background_normal: ""
                                background_active: ""
                                background_color: 0, 0, 0, 0
                                size_hint_x: 1.0  
                                size_hint_y: None
                                height: dp(41) 
                                font_size: '15sp'
                                padding: [dp(8), (self.height - self.line_height) / 2, dp(8), 0]

                    # Tarih
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(45)
                        spacing: dp(15)

                        Label:
                            text: "Tarih"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        BoxLayout:
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(45)
                            padding: [dp(4), dp(2)]
                            canvas.before:
                                Color:
                                    rgba: 0.0, 0.85, 0.4, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.14, 0.12, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                            TextInput:
                                id: product_date
                                hint_text: "Giriş Yapınız..."
                                multiline: False
                                foreground_color: (1, 1, 1, 1)
                                cursor_color: (0.0, 0.95, 0.5, 1)
                                hint_text_color: (0.5, 0.5, 0.5, 1)
                                background_normal: ""
                                background_active: ""
                                background_color: 0, 0, 0, 0
                                size_hint_x: 1.0  
                                size_hint_y: None
                                height: dp(41) 
                                font_size: '15sp'
                                padding: [dp(8), (self.height - self.line_height) / 2, dp(8), 0]

                    # Alt Butonlar (Ürün Ekle & Geri Dön)
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(46)
                        spacing: dp(15)

                        Button:
                            text: "Ürün Ekle"
                            font_size: '15sp'
                            bold: True
                            size_hint_x: 1.0
                            size_hint_y: None
                            height: dp(46)
                            pos_hint: {"center_x": 0.5}
                            background_normal: ''
                            background_down: ''
                            background_color: 0, 0, 0, 0
                            color: 1, 1, 1, 1
                            on_release: root.product_insert()
                            

                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex("#000000") if self.state == "normal" else get_color_from_hex('#000000')
                                RoundedRectangle:
                                    pos: self.x - dp(2), self.y - dp(2)
                                    size: self.width + dp(4), self.height + dp(4)
                                    radius: [dp(14)]

                                Color:
                                    rgba: get_color_from_hex("#00A86B") if self.state == "normal" else get_color_from_hex('#00804D')
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(12)]

                        Button:
                            text: "Geri Dön"
                            font_size: '15sp'
                            bold: True
                            size_hint_x: 1.0
                            size_hint_y: None
                            height: dp(46)
                            pos_hint: {"center_x": 0.5}
                            background_normal: ''
                            background_down: ''
                            background_color: 0, 0, 0, 0
                            color: 1, 1, 1, 1
                            on_release: app.change_screen_randomly('center')

                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex("#000000") if self.state == "normal" else get_color_from_hex('#000000')
                                RoundedRectangle:
                                    pos: self.x - dp(2), self.y - dp(2)
                                    size: self.width + dp(4), self.height + dp(4)
                                    radius: [dp(14)]

                                Color:
                                    rgba: get_color_from_hex("#2c3e50") if self.state == "normal" else get_color_from_hex('#1a252f')
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(12)]