<InsertCompanyScreen>:
    name: "insertcompany"
    Image:
        source: "images/insert_image.png"
        size: root.size
        pos: self.pos
        allow_stretch: True   
        keep_ratio: False     
        mipmap: True

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        size: root.size

        BoxLayout:
            size_hint_y: None
            height: self.minimum_height
            orientation: "vertical"
            padding: dp(20)
            spacing: dp(15)

            # 1. Üst Başlık Alanı
            BoxLayout:
                size_hint_y: None
                height:self.minimum_height
                

                Label:
                    id: ins_label
                    text: "ProSetMan - Firma Ekleme"
                    font_size: '28sp'
                    font_name: "materials/Pacifico-Regular.ttf"
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size
                    color: (0.8, 0.3, 1.0, 1)
                    size_hint_y: None
                    height: self.texture_size[1]  # Yazının o anki gerçek yüksekliği
                    text_size: self.width, None    # Genişlik sabit, yükseklik serbest (alt alta kayabilir)
                    halign: 'left'
                    valign: 'middle'

            # 2. AnchorLayout ile Ortala
            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                size_hint_y: None
                height: insert_card.height

                # Esnek ve Dinamik Kart / Panel (Parlak Mor Cyberpunk Konsept)
                BoxLayout:
                    id: insert_card
                    orientation: "vertical"
                    size_hint_x: 0.94      
                    size_hint_y: None
                    height: self.minimum_height   
                    spacing: dp(14)                   
                    padding: [dp(25), dp(20), dp(25), dp(20)]     
                    
                    canvas.before:
                        # Ana Panel Parlak Mor Çerçeve (Border)
                        Color:
                            rgba: 0.65, 0.15, 0.95, 0.95   
                        RoundedRectangle:
                            pos: self.x - dp(2), self.y - dp(2) 
                            size: self.width + dp(4), self.height + dp(4) 
                            radius: [dp(26)]                

                        # Derin Transparan Siyah Zemin
                        Color:
                            rgba: 0.08, 0.06, 0.12, 0.92 
                        RoundedRectangle:
                            pos: self.pos               
                            size: self.size             
                            radius: [dp(24)]

                    # Firma İsmi (Çerçeveli Kutu)
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Firma İsmi"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        BoxLayout:
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            padding: [dp(4), dp(2)]
                            canvas.before:
                                Color:
                                    rgba: 0.65, 0.15, 0.95, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.10, 0.16, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                            TextInput:
                                id: company_name
                                hint_text: "Giriş Yapınız..."
                                multiline: False
                                foreground_color: 1, 1, 1, 1
                                cursor_color: (0.8, 0.3, 1.0, 1)
                                hint_text_color: 0.5, 0.5, 0.5, 1
                                background_normal: ""
                                background_active: ""
                                background_color: 0, 0, 0, 0
                                font_size: '15sp'
                                padding: [dp(8), (self.height - self.line_height) / 2, dp(8), 0]

                    # Firma Numarası (Çerçeveli Kutu)
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Firma Numarası"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        BoxLayout:
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            padding: [dp(4), dp(2)]
                            canvas.before:
                                Color:
                                    rgba: 0.65, 0.15, 0.95, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.10, 0.16, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                            TextInput:
                                id: company_number
                                hint_text: "Giriş Yapınız..."
                                multiline: False
                                foreground_color: 1, 1, 1, 1
                                cursor_color: (0.8, 0.3, 1.0, 1)
                                hint_text_color: 0.5, 0.5, 0.5, 1
                                background_normal: ""
                                background_active: ""
                                background_color: 0, 0, 0, 0
                                font_size: '15sp'
                                padding: [dp(8), (self.height - self.line_height) / 2, dp(8), 0]

                    # Firma Yetkilisi (Çerçeveli Kutu)
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Firma Yetkilisi"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        BoxLayout:
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            padding: [dp(4), dp(2)]
                            canvas.before:
                                Color:
                                    rgba: 0.65, 0.15, 0.95, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.10, 0.16, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                            TextInput:
                                id: company_person
                                hint_text: "Giriş Yapınız..."
                                multiline: False
                                foreground_color: 1, 1, 1, 1
                                cursor_color: (0.8, 0.3, 1.0, 1)
                                hint_text_color: 0.5, 0.5, 0.5, 1
                                background_normal: ""
                                background_active: ""
                                background_color: 0, 0, 0, 0
                                font_size: '15sp'
                                padding: [dp(8), (self.height - self.line_height) / 2, dp(8), 0]

                    # Sektör Spinner
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Sektör"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        Spinner:
                            id: company_sector
                            text: "Sektör Seçiniz..."
                            values: ["Gıda", "Temizlik", "Okul", "Oyuncak", "Teknoloji", "Tekstil", "Otomotiv", "Kırtasiye", "İnşaat", "Diğer"]
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ""
                            background_down: ""
                            background_color: 0, 0, 0, 0
                            color: 1, 1, 1, 1
                            font_size: '15sp'
                            halign: "center"
                            valign: "middle"

                            canvas.before:
                                Color:
                                    rgba: 0.65, 0.15, 0.95, 0.85
                                RoundedRectangle:
                                    pos: self.x - dp(1), self.y - dp(1)
                                    size: self.width + dp(2), self.height + dp(2)
                                    radius: [dp(6)]
                                Color:
                                    rgba: 0.12, 0.10, 0.16, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                    # Butonlar
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Button:
                            text: "Firma Ekle "
                            font_size: '16sp'
                            bold: True
                            size_hint_x: 1.0
                            size_hint_y: None
                            height: dp(48)
                            pos_hint: {"center_x": 0.5}
                            background_normal: ''
                            background_down: ''
                            background_color: 0, 0, 0, 0
                            color: 1, 1, 1, 1
                            on_release: root.add_company_to_system()

                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex("#000000") if self.state == "normal" else get_color_from_hex('#000000')
                                RoundedRectangle:
                                    pos: self.x - dp(2), self.y - dp(2)
                                    size: self.width + dp(4), self.height + dp(4)
                                    radius: [dp(14)]

                                Color:
                                    rgba: get_color_from_hex("#8E44AD") if self.state == "normal" else get_color_from_hex('#6C3483')
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(12)]

                        Button:
                            text: "Geri Dön"
                            font_size: '16sp'
                            bold: True
                            size_hint_x: 1.0
                            size_hint_y: None
                            height: dp(48)
                            pos_hint: {"center_x": 0.5}
                            background_normal: ''
                            background_down: ''
                            background_color: 0, 0, 0, 0
                            color: 1, 1, 1, 1
                            on_release: app.change_screen_randomly('center')

                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex("#000000") if self.state == "normal" else get_color_from_hex('#000000')
                                RoundedRectangle:
                                    pos: self.x - dp(2), self.y - dp(2)
                                    size: self.width + dp(4), self.height + dp(4)
                                    radius: [dp(14)]

                                Color:
                                    rgba: get_color_from_hex("#2c3e50") if self.state == "normal" else get_color_from_hex('#1a252f')
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(12)]