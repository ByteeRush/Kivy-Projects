<UpdateProductScreen>:
    name: "updateproduct"
    
    Image:
        source: "images/update_image.jpg"
        size: root.size
        pos: self.pos
        allow_stretch: True   
        keep_ratio: False
        mipmap: True

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        size: root.size

        BoxLayout:
            size_hint_y: None
            height: self.minimum_height
            orientation: "vertical"
            padding: dp(20)
            spacing: dp(15)

            # 1. Üst Başlık Alanı
            BoxLayout:
                size_hint_y: None
                height: dp(60)

                Label:
                    id: up_label
                    text: "ProSetMan - Ürün Düzenleme"
                    font_size: '26sp'
                    font_name: "materials/Pacifico-Regular.ttf"
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

            # 2. Düzenleme Kartı
            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                size_hint_y: None
                height: update_card.height

                BoxLayout:
                    id: update_card
                    orientation: "vertical"
                    size_hint_x: 0.94      
                    size_hint_y: None
                    height: self.minimum_height   
                    spacing: dp(12)                   
                    padding: [dp(20), dp(20), dp(20), dp(20)]     
                    
                    canvas.before:
                        Color:
                            rgba: 0.3, 0.3, 0.35, 0.6   
                        RoundedRectangle:
                            pos: self.x - dp(2), self.y - dp(2) 
                            size: self.width + dp(4), self.height + dp(4) 
                            radius: [dp(26)]                

                        Color:
                            rgba: 0.12, 0.12, 0.16, 0.98 
                        RoundedRectangle:
                            pos: self.pos               
                            size: self.size             
                            radius: [dp(24)]

                    # --- 1. Firma / Üretici Adı ---
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(42)
                        spacing: dp(10)

                        Label:
                            text: "Firma / Üretici"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: up_producer_name
                            hint_text: "Firma Adı..."
                            multiline: False
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(42)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)

                    # --- 2. Ürün Tipi ---
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(42)
                        spacing: dp(10)

                        Label:
                            text: "Ürün Tipi"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: up_product_type
                            hint_text: "Örn: Koli, Adet, Paket..."
                            multiline: False
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(42)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)

                    # --- 3. Ürün İsmi ---
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(42)
                        spacing: dp(10)

                        Label:
                            text: "Ürün Adı"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: up_product_name
                            hint_text: "Ürün Adı..."
                            multiline: False
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(42)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)

                    # --- 4. Ürün Adedi ---
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(42)
                        spacing: dp(10)

                        Label:
                            text: "Miktar / Adet"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: up_product_count
                            hint_text: "Miktar..."
                            multiline: False
                            input_filter: 'float'
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(42)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)

                    # --- 5. Birim Fiyatı ---
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(42)
                        spacing: dp(10)

                        Label:
                            text: "Birim Fiyatı (₺)" 
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: up_product_price 
                            hint_text: "Birim Fiyat..." 
                            multiline: False
                            input_filter: 'float'
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(42)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)

                    # --- 6. Barkod ---
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(42)
                        spacing: dp(10)

                        Label:
                            text: "Barkod"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: up_product_barcode
                            hint_text: "Barkod No..."
                            multiline: False
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(42)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)

                    # --- 7. Tarih ---
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(42)
                        spacing: dp(10)

                        Label:
                            text: "Tarih"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: up_product_date
                            hint_text: "GG-AA-YYYY"
                            multiline: False
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(42)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)

                    # --- Butonlar ---
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Button:
                            text: "Ürün Düzenle"
                            font_size: '15sp'
                            size_hint_x: 0.5
                            size_hint_y: None
                            height: dp(44)
                            background_normal: ''
                            background_down: ''
                            background_color: 0, 0, 0, 0
                            on_release: root.save_product()

                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex("#000000")
                                RoundedRectangle:
                                    pos: self.x - dp(2), self.y - dp(2)
                                    size: self.width + dp(4), self.height + dp(4)
                                    radius: [dp(18)]

                                Color:
                                    rgba: get_color_from_hex("#0c0c6d") if self.state == "normal" else get_color_from_hex('#151593')
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(16)]

                        Button:
                            text: "Geri Dön"
                            font_size: '15sp'
                            size_hint_x: 0.5
                            size_hint_y: None
                            height: dp(44)
                            background_normal: ''
                            background_down: ''
                            background_color: 0, 0, 0, 0
                            on_release: app.change_screen_randomly('products')

                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex("#000000")
                                RoundedRectangle:
                                    pos: self.x - dp(2), self.y - dp(2)
                                    size: self.width + dp(4), self.height + dp(4)
                                    radius: [dp(18)]

                                Color:
                                    rgba: get_color_from_hex("#de512b") if self.state == "normal" else get_color_from_hex('#b83e1e')
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(16)]