<InsertProductScreen>:
    name: "insertproduct"
    Image:
        source: "images/insert_image.png"
        size: root.size
        pos: self.pos
        allow_stretch: True   
        keep_ratio: False     # <--- BURAYI 'False' YAP! Ekranı tıklim tıklim doldurur, boşluk bırakmaz.
        mipmap: True
   

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        size: root.size

        BoxLayout:
            size_hint_y: None
            height: self.minimum_height
            orientation: "vertical"
            padding: dp(20)
            spacing: dp(15)

            # 1. Üst Başlık Alanı
            BoxLayout:
                size_hint_y: None
                height: dp(70)

                Label:
                    id: ins_label
                    text: "ProSetMan - Ürün Ekleme"
                    font_size: '28sp'
                    font_name: "materials/Pacifico-Regular.ttf"
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

            # 2. AnchorLayout ile Ortala
            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                size_hint_y: None
                height: insert_card.height

                BoxLayout:
                    id: insert_card
                    orientation: "vertical"
                    size_hint_x: 0.94      
                    size_hint_y: None
                    height: self.minimum_height   
                    spacing: dp(14)                   
                    padding: [dp(25), dp(20), dp(25), dp(20)]     
                    
                    canvas.before:
                        Color:
                            rgba: 0.3, 0.3, 0.35, 0.6   
                        RoundedRectangle:
                            pos: self.x - dp(2), self.y - dp(2) 
                            size: self.width + dp(4), self.height + dp(4) 
                            radius: [dp(26)]                

                        Color:
                            rgba: 0.12, 0.12, 0.16, 0.98 
                        RoundedRectangle:
                            pos: self.pos               
                            size: self.size             
                            radius: [dp(24)]


                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: 10

                        Image:
                            id: product_image_preview
                            # Başlangıçta boş bırakıyoruz ki None veya eksik dosya hatası vermesin
                            source: '' 
                            size_hint_y: None
                            height: '150dp'
                            allow_stretch: True

                        BoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: dp(48)
                            spacing: dp(15)
                        
                            Button:
                                text: "📷 Ürün Fotoğrafı Seç / Ekle"
                                size_hint_y: None
                                height: '40dp'
                                background_color: 0.2, 0.5, 0.8, 1
                                on_release: root.select_product_image()
                    

                            Button:
                                text: "📸 Kamera ile Çek"
                                size_hint_y: None
                                height: '40dp'
                                background_color: 0.2, 0.5, 0.8, 1
                                on_release: root.take_photo_with_camera()
                                    
                    
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Firma İsmi"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: producer_name
                            hint_text: "Giriş Yapınız..."
                            multiline: False
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)
                    
                    
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Ürün Tipi"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: product_type
                            hint_text: "Giriş Yapınız..."
                            multiline: False
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)
                    
        
                    
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Ürün İsmi"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: product_name
                            hint_text: "Giriş Yapınız..."
                            multiline: False
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)

                  
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Ürün Adedi"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: product_count
                            hint_text: "Giriş Yapınız..."
                            multiline: False
                            input_filter: 'int'
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)

            
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Ürün Birim Fiyatı"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: product_price
                            hint_text: "Giriş Yapınız..."
                            multiline: False
                            input_filter: 'float'
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)



                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Ürün Toplam Tutar"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: product_total_price
                            hint_text: "Giriş Yapınız..."
                            multiline: False
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)
                            on_text:root.calculate_total()





                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Barcode Code"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: product_barcode
                            hint_text: "Giriş Yapınız..."
                            multiline: False
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)




                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Label:
                            text: "Tarih"
                            size_hint_x: 0.35
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        TextInput:
                            id: product_date
                            hint_text: "Giriş Yapınız..."
                            multiline: False
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: dp(48)
                            foreground_color: (1, 1, 1, 1)
                            background_color: (0.15, 0.15, 0.15, 1)


                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(15)

                        Button:
                            text: "Ürün Ekle"
                            font_size: '16sp'
                            size_hint_x: 1.0
                            size_hint_y: None
                            height: dp(48)
                            pos_hint: {"center_x": 0.5}
                            background_normal: ''
                            background_down: ''
                            background_color: 0, 0, 0, 0
                            on_release: root.add_product_to_system()

                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex("#000000") if self.state == "normal" else get_color_from_hex('#000000')
                                RoundedRectangle:
                                    pos: self.x - dp(2), self.y - dp(2)
                                    size: self.width + dp(4), self.height + dp(4)
                                    radius: [dp(22)]

                                Color:
                                    rgba: get_color_from_hex("#0c0c6d") if self.state == "normal" else get_color_from_hex('#0c0c6d')
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(20)]

                        Button:
                            text: "Geri Dön"
                            font_size: '16sp'
                            size_hint_x: 1.0
                            size_hint_y: None
                            height: dp(48)
                            pos_hint: {"center_x": 0.5}
                            background_normal: ''
                            background_down: ''
                            background_color: 0, 0, 0, 0
                            on_release: app.change_screen_randomly('products')

                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex("#000000") if self.state == "normal" else get_color_from_hex('#000000')
                                RoundedRectangle:
                                    pos: self.x - dp(2), self.y - dp(2)
                                    size: self.width + dp(4), self.height + dp(4)
                                    radius: [dp(22)]

                                Color:
                                    rgba: get_color_from_hex("#de512b") if self.state == "normal" else get_color_from_hex('#de512b')
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(20)]