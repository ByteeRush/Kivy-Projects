<LoginScreen>:
    name: 'login'

    #canvas.before:
    #    Color:
    #        rgba: 1, 1, 1, 1
    #    Rectangle:
    #        pos: self.pos
    #        size: self.size
    #        source: "images/login_image.jpg"

    Image:
        source: "images/login_image.jpg"
        size: root.size
        pos: self.pos
        allow_stretch: True   
        keep_ratio: False     # <--- BURAYI 'False' YAP! Ekranı tıklim tıklim doldurur, boşluk bırakmaz.
        mipmap: True
   
            
    
    # Mobilde klavye açıldığında taşmayı ve sıkışmayı önleyen ScrollView
    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        size: root.size

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(15)
            padding: [dp(20), dp(40), dp(20), dp(40)]

            # Başlık (Mobilde ekrana sığacak şekilde optimize edildi)
            Label:
                id: login_label
                text: "ProSetMan - Welcome Login!"
                font_size: '20sp'
                font_name: "materials/Pacifico-Regular.ttf"
                size_hint_y: None
                height: dp(60)
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            # Kartı ekranda kusursuz ortalayan AnchorLayout
            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                size_hint_y: None
                height: card_layout.height

                # Esnek ve Dinamik Kart / Panel
                BoxLayout:
                    id: card_layout
                    orientation: "vertical"
                    size_hint: 0.9, None
                    height: self.minimum_height
                    pos_hint: {"center_x": 0.5}
                    spacing: dp(14)
                    padding: [dp(25), dp(20), dp(25), dp(20)]

                    canvas.before:
                        Color:
                            rgba: 0.3, 0.3, 0.35, 0.6
                        RoundedRectangle:
                            pos: self.x - dp(2), self.y - dp(2)
                            size: self.width + dp(4), self.height + dp(4)
                            radius: [dp(26)]

                        Color:
                            rgba: 0.12, 0.12, 0.16, 0.72
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(24)]
                

                    TextInput:
                        id: login_username
                        hint_text: "Enter Your Name:"
                        multiline: False
                        foreground_color: (1, 1, 1, 1)
                        background_color: (0.15, 0.15, 0.15, 1)
                        cursor_color: (1, 1, 1, 1)
                        size_hint_x: 1.0  
                        size_hint_y: None
                        height: dp(45) 
                        pos_hint: {"center_x": 0.5}

                   

                    TextInput:
                        id: login_password
                        hint_text: "Enter Your Password:"
                        multiline: False
                        password: True
                        foreground_color: (1, 1, 1, 1)
                        background_color: (0.15, 0.15, 0.15, 1)
                        cursor_color: (1, 1, 1, 1)
                        size_hint_x: 1.0
                        size_hint_y: None
                        height: dp(45) 
                        pos_hint: {"center_x": 0.5}

                    Button:
                        text: "Submit"
                        font_size: '16sp'
                        size_hint_x: 1.0
                        size_hint_y: None
                        height: dp(45) 
                        pos_hint: {"center_x": 0.5}
                        background_normal: ''
                        background_down: ''
                        background_color: 0, 0, 0, 0
                        on_release: root.login_to_app()

                        canvas.before:
                            Color:
                                rgba: get_color_from_hex("#000000") if self.state == "normal" else get_color_from_hex('#000000')
                            RoundedRectangle:
                                pos: self.x - dp(2), self.y - dp(2)
                                size: self.width + dp(4), self.height + dp(4)
                                radius: [dp(22)]

                            Color:
                                rgba: get_color_from_hex("#00F5A0") if self.state == "normal" else get_color_from_hex('#00F5A0')
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(20)]

                    Button:
                        text: "Register"
                        font_size: '16sp'
                        size_hint_x: 1.0
                        size_hint_y: None
                        height: dp(45)
                        pos_hint: {"center_x": 0.5}
                        color: (1, 1, 1, 1)
                        on_release: app.change_screen_randomly('register')
                        
                        background_normal: ''
                        background_down: ''
                        background_color: 0, 0, 0, 0
                        
                        canvas.before:
                            Color:
                                rgba: get_color_from_hex('#000000') if self.state == 'normal' else get_color_from_hex('#000000')
                            RoundedRectangle:
                                pos: self.x - dp(2), self.y - dp(2)
                                size: self.width + dp(4), self.height + dp(4)
                                radius: [dp(22)]

                            Color:
                                rgba: get_color_from_hex('#79CBCA') if self.state == 'normal' else get_color_from_hex('#5fa8a7')
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size 
                                radius: [dp(20)]